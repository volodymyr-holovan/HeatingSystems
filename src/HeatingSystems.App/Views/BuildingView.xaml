<UserControl x:Class="HeatingSystems.App.Views.BuildingView"
             xmlns:l="clr-namespace:HeatingSystems.App.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,24">
            <!-- Validation banner -->
            <Border Style="{StaticResource Card}" Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{l:Tr building.checkInput}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr building.climate}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.city}" />
                            <ComboBox ItemsSource="{Binding Climates}" SelectedItem="{Binding SelectedClimate}" DisplayMemberPath="City" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.indoorTemperature}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="°C" />
                            <TextBox Text="{Binding IndoorTemperature, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding ClimateSummary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr building.geometry}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.floorArea}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m2}" />
                            <TextBox Text="{Binding HeatedFloorArea, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.roomHeight}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m}" />
                            <TextBox Text="{Binding CeilingHeight, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.volume}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m3}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding HeatedVolume, StringFormat={}{0:N1}}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                            <TextBlock Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold"><Run Text="U = " /><Run Text="{Binding WallUValue, StringFormat=N3, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.Wm2K}" /></TextBlock>
                        </Border>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81E;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr loss.walls}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="{l:Tr building.wallArea.tip}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.wallArea}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m2}" />
                            <TextBox Text="{Binding ExternalWallArea, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.baseLayer}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.mm}" />
                            <TextBox DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Text="{Binding WallThicknessMm, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            <ComboBox ItemsSource="{Binding StructuralMaterials}" SelectedItem="{Binding WallMaterial}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.insulationNone}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.mm}" />
                            <TextBox DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Text="{Binding WallInsulationMm, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            <ComboBox ItemsSource="{Binding InsulationMaterials}" SelectedItem="{Binding WallInsulation}" DisplayMemberPath="Name" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr building.windowsDoors}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.windowType}" />
                            <ComboBox ItemsSource="{Binding WindowTypes}" SelectedItem="{Binding WindowType}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.windowArea}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m2}" />
                            <TextBox Text="{Binding WindowArea, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.doorArea}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m2}" />
                            <TextBox Text="{Binding DoorArea, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.doorU}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.Wm2K}" />
                            <TextBox Text="{Binding DoorUValue, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                            <TextBlock Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold"><Run Text="U = " /><Run Text="{Binding RoofUValue, StringFormat=N3, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.Wm2K}" /></TextBlock>
                        </Border>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr building.roof}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr common.type}" />
                            <ComboBox ItemsSource="{Binding RoofTypes}" SelectedItem="{Binding RoofType}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr common.area}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m2}" />
                            <TextBox Text="{Binding RoofArea, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.baseLayer}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.mm}" />
                            <TextBox DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Text="{Binding RoofThicknessMm, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            <ComboBox ItemsSource="{Binding StructuralMaterials}" SelectedItem="{Binding RoofMaterial}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.insulation}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.mm}" />
                            <TextBox DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Text="{Binding RoofInsulationMm, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            <ComboBox ItemsSource="{Binding InsulationMaterials}" SelectedItem="{Binding RoofInsulation}" DisplayMemberPath="Name" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                            <TextBlock Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold"><Run Text="U = " /><Run Text="{Binding FloorUValue, StringFormat=N3, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.Wm2K}" /></TextBlock>
                        </Border>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81E;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr building.floor}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr common.type}" />
                            <ComboBox ItemsSource="{Binding FloorTypes}" SelectedItem="{Binding FloorType}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr common.area}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m2}" />
                            <TextBox Text="{Binding FloorArea, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="{l:Tr building.perimeter.tip}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.perimeter}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.m}" />
                            <TextBox Text="{Binding FloorPerimeter, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.baseLayer}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.mm}" />
                            <TextBox DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Text="{Binding FloorThicknessMm, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            <ComboBox ItemsSource="{Binding StructuralMaterials}" SelectedItem="{Binding FloorMaterial}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.insulation}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.mm}" />
                            <TextBox DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Text="{Binding FloorInsulationMm, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            <ComboBox ItemsSource="{Binding InsulationMaterials}" SelectedItem="{Binding FloorInsulation}" DisplayMemberPath="Name" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9CA;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr building.ventilationSection}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="{l:Tr building.airChange.tip}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.airChange}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.perHour}" />
                            <TextBox Text="{Binding AirChangeRate, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="{l:Tr building.n50.tip}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.n50}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.perHour}" />
                            <TextBox Text="{Binding AirTightnessN50, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.shielding}" />
                            <ComboBox ItemsSource="{Binding ShieldingOptions}" SelectedItem="{Binding Shielding}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <CheckBox Content="{l:Tr building.mechanicalVentilation}" IsChecked="{Binding MechanicalVentilation}" />
                        <DockPanel Style="{StaticResource FormRow}" IsEnabled="{Binding MechanicalVentilation}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.heatRecovery}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="%" />
                            <TextBox Text="{Binding HeatRecoveryPercent, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="{l:Tr building.thermalBridge.tip}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.thermalBridge}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.Wm2K}" />
                            <TextBox Text="{Binding ThermalBridgeSurcharge, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="{l:Tr building.gains.tip}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.gains}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.Wm2}" />
                            <TextBox Text="{Binding InternalGains, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.thermalMass}" />
                            <ComboBox ItemsSource="{Binding ThermalMasses}" SelectedItem="{Binding ThermalMass}" DisplayMemberPath="Name" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,10" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr building.heatingSection}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.emitters}" />
                            <ComboBox ItemsSource="{Binding Emitters}" SelectedItem="{Binding Emitter}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <CheckBox Content="{l:Tr building.includeHotWater}" IsChecked="{Binding IncludeHotWater}" />
                        <StackPanel IsEnabled="{Binding IncludeHotWater}">
                            <DockPanel Style="{StaticResource FormRow}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.occupants}" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.persons}" />
                                <TextBox Text="{Binding Occupants, Converter={StaticResource Num0}, ValidatesOnExceptions=True}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FormRow}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.hotWaterUse}" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="{l:Tr unit.litresPerPersonDay}" />
                                <TextBox Text="{Binding HotWaterLitres, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FormRow}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr building.hotWaterTemperature}" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="°C" />
                                <TextBox Text="{Binding HotWaterTemperature, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
