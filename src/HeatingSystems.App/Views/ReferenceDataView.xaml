<UserControl x:Class="HeatingSystems.App.Views.ReferenceDataView"
             xmlns:l="clr-namespace:HeatingSystems.App.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="24,18,24,24" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="14">
        <TabItem Header="{l:Tr reference.tariffs}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="{StaticResource AccentLightBrush}" BorderBrush="{StaticResource AccentLightBrush}" Padding="14,10">
                    <TextBlock TextWrapping="Wrap"
                               Text="{l:Tr reference.tariffs.note}" />
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{l:Tr reference.discard}" Command="{Binding DiscardTariffsCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr reference.saveTariffs}" Command="{Binding SaveTariffsCommand}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Carriers}" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Tr reference.carrier}" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="1.4*" />
                        <DataGridTextColumn Header="{l:Tr reference.unit}" Binding="{Binding Unit, Mode=OneWay}" IsReadOnly="True" Width="80" />
                        <DataGridTextColumn Header="{l:Tr reference.energyPerUnit}" Binding="{Binding EnergyPerUnit, Mode=OneWay, StringFormat={}{0:N2}}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.price}" Binding="{Binding Price, Converter={StaticResource Num}, ValidatesOnExceptions=True}" Width="110" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.pricePerKWh}" Binding="{Binding PricePerKWh, Mode=OneWay, StringFormat={}{0:N2}}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.co2}" Binding="{Binding Co2, Converter={StaticResource Num}, ValidatesOnExceptions=True}" Width="115" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr common.source}" Binding="{Binding Source, Mode=OneWay}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource WrapCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="{l:Tr reference.climate}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,10"
                           Text="{l:Tr reference.climate.note}" />
                <DataGrid ItemsSource="{Binding Climates}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Tr common.city}" Binding="{Binding City}" Width="1.2*" />
                        <DataGridTextColumn Header="{l:Tr reference.region}" Binding="{Binding Region}" Width="1.4*" />
                        <DataGridTextColumn Header="θe, °C" Binding="{Binding DesignTemperature, StringFormat={}{0:N0}}" Width="70" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.days}" Binding="{Binding Days}" Width="60" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.seasonMean}" Binding="{Binding MeanTemperature, StringFormat={}{0:N1}}" Width="85" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.annualMean}" Binding="{Binding AnnualMean, StringFormat={}{0:N1}}" Width="85" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.degreeDays}" Binding="{Binding DegreeDays, StringFormat={}{0:N0}}" Width="95" ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{l:Tr reference.zone}" Binding="{Binding Zone}" Width="55" ElementStyle="{StaticResource NumericCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="{l:Tr reference.materials}">
            <DataGrid ItemsSource="{Binding Materials}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr reference.material}" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="{l:Tr reference.category}" Binding="{Binding Category}" Width="110" />
                    <DataGridTextColumn Header="{l:Tr reference.lambda}" Binding="{Binding Conductivity, StringFormat={}{0:N3}}" Width="95" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr reference.density}" Binding="{Binding Density, StringFormat={}{0:N0}}" Width="80" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr common.source}" Binding="{Binding Source}" Width="2*" ElementStyle="{StaticResource WrapCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>

        <TabItem Header="{l:Tr loss.windows}">
            <DataGrid ItemsSource="{Binding Windows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr reference.windowType}" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="{l:Tr reference.uw}" Binding="{Binding UValue, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="g" Binding="{Binding GValue, StringFormat={}{0:N2}}" Width="60" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr common.source}" Binding="{Binding Source}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>

        <TabItem Header="{l:Tr reference.generators}">
            <DataGrid ItemsSource="{Binding Technologies}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr reference.technology}" Binding="{Binding Name}" Width="1.6*" />
                    <DataGridTextColumn Header="{l:Tr reference.fuel}" Binding="{Binding CarrierCode}" Width="110" />
                    <DataGridTextColumn Header="{l:Tr reference.seasonalEfficiency}" Binding="{Binding SeasonalEfficiency, StringFormat={}{0:P0}}" Width="105" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr reference.lowTempBonus}" Binding="{Binding LowTemperatureBonus, StringFormat={}{0:P0}}" Width="100" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr reference.description}" Binding="{Binding Description}" Width="2*" ElementStyle="{StaticResource WrapCell}" />
                    <DataGridTextColumn Header="{l:Tr common.source}" Binding="{Binding Source}" Width="1.4*" ElementStyle="{StaticResource WrapCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>

        <TabItem Header="{l:Tr reference.dataSources}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr reference.catalog}" />
                    <TextBlock Text="{Binding CatalogSource}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="{l:Tr reference.catalog.note}" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr reference.method}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{l:Tr reference.method.text}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
