<UserControl x:Class="HeatingSystems.App.Views.RecommendationView"
             xmlns:l="clr-namespace:HeatingSystems.App.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Options -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr recommendation.heatSource}" />
                        <CheckBox Content="{l:Tr source.air}" IsChecked="{Binding UseAir}" />
                        <CheckBox Content="{l:Tr recommendation.brine}" IsChecked="{Binding UseBrine}" />
                        <CheckBox Content="{l:Tr recommendation.water}" IsChecked="{Binding UseWater}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr recommendation.constraints}" />
                        <CheckBox Content="{l:Tr recommendation.natural}" IsChecked="{Binding NaturalRefrigerantsOnly}" />
                        <TextBlock Text="{l:Tr recommendation.maxNoise}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding MaxNoise, Converter={StaticResource Num}, ValidatesOnExceptions=True}" ToolTip="{l:Tr recommendation.maxNoise.tip}" />
                        <TextBlock Text="{l:Tr recommendation.minCoverage}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding MinCoveragePercent, Converter={StaticResource Num}, ValidatesOnExceptions=True}"
                                 ToolTip="{l:Tr recommendation.minCoverage.tip}" />
                        <TextBlock Text="{l:Tr recommendation.maxSizing}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding MaxSizingRatio, Converter={StaticResource Num}, ValidatesOnExceptions=True}"
                                 ToolTip="{l:Tr recommendation.maxSizing.tip}" />
                        <TextBlock Text="{l:Tr recommendation.count}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Count, Converter={StaticResource Num0}, ValidatesOnExceptions=True}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr recommendation.run}" Command="{Binding RecommendCommand}" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}"
                           Text="{l:Tr recommendation.method}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Results -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="{StaticResource InfoLightBrush}" BorderBrush="{StaticResource InfoLightBrush}" Padding="14,10">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>

            <!-- Details of the selected unit -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding Selected}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="4" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Manufacturer}" />
                        <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Variants}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr recommendation.capacity}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding CapacityAtDesignKw, StringFormat=N1, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kW}" /></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr recommendation.spfPair}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold">
                            <Run Text="{Binding SpaceHeatingSpf, StringFormat={}{0:N2}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding OverallSpf, StringFormat={}{0:N2}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr recommendation.bivalent}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Bivalent}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr recommendation.electricity}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Electricity, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kWh}" /></TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource Caption}" Margin="0,10,0,0">
                        <Run Text="{l:Tr recommendation.detail.refrigerant}" /><Run Text="{Binding Refrigerant, Mode=OneWay}" />
                        <Run Text="{l:Tr recommendation.detail.noise}" /><Run Text="{Binding Noise, Mode=OneWay}" />
                        <Run Text="{l:Tr recommendation.detail.backup}" /><Run Text="{Binding BackupHours, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text="{l:Tr recommendation.detail.hoursPerYear}" />
                        <Run Text="{l:Tr recommendation.detail.scop}" /><Run Text="{Binding CertifiedScop, StringFormat={}{0:N2}, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>

            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="36" />
                    <DataGridTemplateColumn Header="{l:Tr recommendation.model}" Width="2.4*" SortMemberPath="Model">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr common.type}" Binding="{Binding SourceName}" Width="100" />
                    <DataGridTextColumn Header="{l:Tr catalog.p35}" Binding="{Binding RatedPower, StringFormat={}{0:N1}}" Width="70" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr recommendation.scop}" Binding="{Binding CertifiedScop, StringFormat={}{0:N2}}" Width="75" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr recommendation.spf}" Binding="{Binding OverallSpf, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr recommendation.coverage}" Binding="{Binding Coverage, StringFormat={}{0:P1}}" Width="75" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr recommendation.cost}" Binding="{Binding AnnualCost, StringFormat={}{0:N0}}" Width="80" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="{l:Tr recommendation.co2}" Binding="{Binding AnnualCo2, StringFormat={}{0:N0}}" Width="70" ElementStyle="{StaticResource NumericCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
