<UserControl x:Class="HeatingSystems.App.Views.RecommendationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Options -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Джерело теплоти" />
                        <CheckBox Content="Повітря–вода" IsChecked="{Binding UseAir}" />
                        <CheckBox Content="Ґрунт–вода (свердловини, колектор)" IsChecked="{Binding UseBrine}" />
                        <CheckBox Content="Вода–вода (ґрунтові води)" IsChecked="{Binding UseWater}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Обмеження" />
                        <CheckBox Content="Лише природні холодоагенти (R290 тощо)" IsChecked="{Binding NaturalRefrigerantsOnly}" />
                        <TextBlock Text="Макс. звукова потужність зовн. блока, дБ(А)" Margin="0,8,0,4" />
                        <TextBox Text="{Binding MaxNoise, Converter={StaticResource Num}, ValidatesOnExceptions=True}" ToolTip="0 — без обмеження" />
                        <TextBlock Text="Мін. частка теплоти від компресора, %" Margin="0,8,0,4" />
                        <TextBox Text="{Binding MinCoveragePercent, Converter={StaticResource Num}, ValidatesOnExceptions=True}"
                                 ToolTip="Решту покриває електричний ТЕН (моноенергетична схема)" />
                        <TextBlock Text="Макс. співвідношення Pdesignh / Φ_HL" Margin="0,8,0,4" />
                        <TextBox Text="{Binding MaxSizingRatio, Converter={StaticResource Num}, ValidatesOnExceptions=True}"
                                 ToolTip="Обмеження завищення потужності (типово 2)" />
                        <TextBlock Text="Кількість результатів" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Count, Converter={StaticResource Num0}, ValidatesOnExceptions=True}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Підібрати" Command="{Binding RecommendCommand}" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}"
                           Text="Кожну модель змодельовано bin-методом EN 14825 для вашої будівлі та клімату: COP і потужність — за регресійною моделлю hplib на даних сертифікації Heat Pump KEYMARK; температура подачі — за опалювальним графіком; нижче межі роботи (TOL) та при нестачі потужності працює ТЕН." />
            </StackPanel>
        </ScrollViewer>

        <!-- Results -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="{StaticResource InfoLightBrush}" BorderBrush="{StaticResource InfoLightBrush}" Padding="14,10">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>

            <!-- Details of the selected unit -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding Selected}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="4" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Manufacturer}" />
                        <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Variants}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource Caption}" Text="Потужність при θe" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding CapacityAtDesignKw, StringFormat='{}{0:N1} кВт'}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Style="{StaticResource Caption}" Text="SPF опалення / загальний" />
                        <TextBlock FontSize="18" FontWeight="SemiBold">
                            <Run Text="{Binding SpaceHeatingSpf, StringFormat={}{0:N2}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding OverallSpf, StringFormat={}{0:N2}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource Caption}" Text="Точка бівалентності" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Bivalent}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <TextBlock Style="{StaticResource Caption}" Text="Електроенергія на рік" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Electricity, StringFormat='{}{0:N0} кВт·год'}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource Caption}" Margin="0,10,0,0">
                        <Run Text="Холодоагент: " /><Run Text="{Binding Refrigerant, Mode=OneWay}" />
                        <Run Text=" · шум зовн. блока: " /><Run Text="{Binding Noise, Mode=OneWay}" />
                        <Run Text=" · робота ТЕНа: " /><Run Text="{Binding BackupHours, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text=" год/рік" />
                        <Run Text=" · SCOP сертифікований: " /><Run Text="{Binding CertifiedScop, StringFormat={}{0:N2}, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>

            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="36" />
                    <DataGridTemplateColumn Header="Виробник / модель" Width="2.4*" SortMemberPath="Model">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Тип" Binding="{Binding SourceName}" Width="100" />
                    <DataGridTextColumn Header="P35, кВт" Binding="{Binding RatedPower, StringFormat={}{0:N1}}" Width="70" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="SCOP серт." Binding="{Binding CertifiedScop, StringFormat={}{0:N2}}" Width="75" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="SPF розрах." Binding="{Binding OverallSpf, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="Покриття" Binding="{Binding Coverage, StringFormat={}{0:P1}}" Width="75" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="Грн/рік" Binding="{Binding AnnualCost, StringFormat={}{0:N0}}" Width="80" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="CO₂, кг" Binding="{Binding AnnualCo2, StringFormat={}{0:N0}}" Width="70" ElementStyle="{StaticResource NumericCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
