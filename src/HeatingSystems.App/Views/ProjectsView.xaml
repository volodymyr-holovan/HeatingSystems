<UserControl x:Class="HeatingSystems.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Видалити" Command="{Binding DeleteCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Відкрити" Command="{Binding OpenCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"
                       Text="Проєкти зберігаються в локальній базі даних SQLite. Подвійне клацання відкриває проєкт і перераховує його." />
        </DockPanel>
        <Grid>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Місто" Binding="{Binding City}" Width="*" />
                    <DataGridTextColumn Header="Навантаження, Вт" Binding="{Binding DesignHeatLoad, StringFormat={}{0:N0}}" Width="130" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="Потреба, кВт·год/рік" Binding="{Binding AnnualDemand, StringFormat={}{0:N0}}" Width="150" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="Збережено" Binding="{Binding SavedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15"
                       Text="Збережених проєктів ще немає. Натисніть «Зберегти» у верхній панелі."
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
