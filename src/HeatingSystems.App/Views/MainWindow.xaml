<Window x:Class="HeatingSystems.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HeatingSystems.App.ViewModels"
        xmlns:views="clr-namespace:HeatingSystems.App.Views"
        Title="{Binding WindowTitle}"
        Width="1360" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BuildingViewModel}"><views:BuildingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><views:ResultsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComparisonViewModel}"><views:ComparisonView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecommendationViewModel}"><views:RecommendationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><views:CatalogView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReferenceDataViewModel}"><views:ReferenceDataView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CalculateCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ExportReportCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================== Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,24">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9CA;" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Системи опалення" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="підбір та розрахунок" Foreground="{StaticResource SidebarTextBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="22,12,16,18" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource SidebarTextBrush}" Opacity="0.8"
                           Text="F5 — розрахувати · Ctrl+S — зберегти · Ctrl+P — звіт" />

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Width="26" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======================================================== Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Проєкт:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
                        <Button Command="{Binding NewProjectCommand}" ToolTip="Новий проєкт (Ctrl+N)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Новий" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveProjectCommand}" ToolTip="Зберегти проєкт у базі даних (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Зберегти" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveProjectAsCommand}" Content="Зберегти як новий" ToolTip="Зберегти копію проєкту" />
                        <Button Command="{Binding ExportReportCommand}" ToolTip="Експортувати звіт у HTML (Ctrl+P)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Звіт" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CalculateCommand}" ToolTip="Виконати розрахунок (F5)" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,6,0" Foreground="White" />
                                <TextBlock Text="Розрахувати" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding SelectedPage.Title}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedPage.Subtitle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" Focusable="False" />

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,6">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
