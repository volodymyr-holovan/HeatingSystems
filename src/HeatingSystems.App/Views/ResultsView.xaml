<UserControl x:Class="HeatingSystems.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="48" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Результатів ще немає" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Style="{StaticResource Caption}" Text="Заповніть дані на сторінці «Будівля» та натисніть «Розрахувати» (F5)." HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24,18,24,24">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Location}" Margin="0,0,0,10" FontSize="13" />

                <!-- KPI tiles -->
                <UniformGrid Columns="4" Margin="-7,0,-7,7">
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Розрахункове теплове навантаження" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{StaticResource AccentBrush}" Text="{Binding DesignHeatLoadKw, StringFormat='{}{0:N2} кВт'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="EN 12831, при θe" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Питоме навантаження" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding SpecificHeatLoad, StringFormat='{}{0:N1} Вт/м²'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="на 1 м² опалюваної площі" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Річна потреба на опалення" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding SpaceHeating, StringFormat='{}{0:N0} кВт·год'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SpecificSpaceHeating, StringFormat='{}{0:N0} кВт·год/(м²·рік)'}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Гаряче водопостачання" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding HotWater, StringFormat='{}{0:N0} кВт·год'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="на рік, з втратами" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Background="{StaticResource InfoLightBrush}" BorderBrush="{StaticResource InfoLightBrush}" Padding="14,10">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Оцінка енергоефективності: " FontWeight="SemiBold" />
                        <Run Text="{Binding EfficiencyLabel, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Loss structure -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Структура тепловтрат при розрахунковій температурі" />
                            <ItemsControl ItemsSource="{Binding LossBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar x:Name="Bar" Grid.Column="1" Style="{StaticResource Bar}" Value="{Binding Fraction, Mode=OneWay}" Height="14" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ventilation">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ChartVentilationBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ground">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ChartGroundBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource ChartTransmissionBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="теплопередача" Margin="0,0,14,0" />
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource ChartGroundBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="ґрунт (EN ISO 13370)" Margin="0,0,14,0" />
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource ChartVentilationBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="вентиляція та інфільтрація" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Parameters and envelope check -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Розрахункові параметри" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Коефіцієнт теплопередачі H_T" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TransmissionCoefficient, StringFormat='{}{0:N1} Вт/К'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="Вентиляційний коефіцієнт H_V" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VentilationCoefficient, StringFormat='{}{0:N1} Вт/К'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="Розрахункова витрата повітря" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EffectiveAirFlow, StringFormat='{}{0:N0} м³/год'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="3" Text="Градусо-доби опалювального періоду" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DegreeDays, StringFormat='{}{0:N0} К·діб'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="4" Text="Тепловтрати за опалювальний період" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HeatLosses, StringFormat='{}{0:N0} кВт·год'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="5" Text="Використані внутрішні теплонадходження" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UtilisedGains, StringFormat='{}{0:N0} кВт·год'}" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Відповідність ДБН В.2.6-31 (опір теплопередачі)" />
                                <ItemsControl ItemsSource="{Binding EnvelopeChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <Border x:Name="Pill" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="{StaticResource SuccessLightBrush}">
                                                    <TextBlock x:Name="PillText" Text="відповідає" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Caption}">
                                                        <Run Text="R = " /><Run Text="{Binding ActualResistance, StringFormat={}{0:N2}, Mode=OneWay}" />
                                                        <Run Text=" м²·К/Вт · Rq,min = " /><Run Text="{Binding RequiredResistance, StringFormat={}{0:N2}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Complies}" Value="False">
                                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerLightBrush}" />
                                                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter TargetName="PillText" Property="Text" Value="не відповідає" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Energy by outdoor temperature -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Розподіл річної потреби на опалення за зовнішньою температурою" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,-6,0,12"
                                   Text="Bin-метод (EN 14825): кожен стовпчик — енергія, спожита в годинах з відповідною зовнішньою температурою. Наведіть курсор для деталей." />
                        <ItemsControl ItemsSource="{Binding BinBars}" Height="190">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0" ToolTip="{Binding ValueText}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="{Binding Height}" CornerRadius="3,3,0,0" Background="{StaticResource AccentBrush}" Opacity="0.85" />
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Text="Зовнішня температура, °C" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
