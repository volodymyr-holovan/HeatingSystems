<UserControl x:Class="HeatingSystems.App.Views.ResultsView"
             xmlns:l="clr-namespace:HeatingSystems.App.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="48" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr results.empty}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.empty.hint}" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24,18,24,24">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Location}" Margin="0,0,0,10" FontSize="13" />

                <!-- KPI tiles -->
                <UniformGrid Columns="4" Margin="-7,0,-7,7">
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.designLoad}" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{StaticResource AccentBrush}"><Run Text="{Binding DesignHeatLoadKw, StringFormat=N2, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kW}" /></TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.designLoad.caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.specificLoad}" />
                            <TextBlock Style="{StaticResource KpiValue}"><Run Text="{Binding SpecificHeatLoad, StringFormat=N1, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.Wm2}" /></TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.specificLoad.caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.spaceHeating}" />
                            <TextBlock Style="{StaticResource KpiValue}"><Run Text="{Binding SpaceHeating, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kWh}" /></TextBlock>
                            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding SpecificSpaceHeating, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kWhm2Year}" /></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.hotWater}" />
                            <TextBlock Style="{StaticResource KpiValue}"><Run Text="{Binding HotWater, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kWh}" /></TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.hotWater.caption}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Background="{StaticResource InfoLightBrush}" BorderBrush="{StaticResource InfoLightBrush}" Padding="14,10">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{l:Tr results.efficiencyRating}" FontWeight="SemiBold" />
                        <Run Text="{Binding EfficiencyLabel, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Loss structure -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr results.lossStructure}" />
                            <ItemsControl ItemsSource="{Binding LossBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar x:Name="Bar" Grid.Column="1" Style="{StaticResource Bar}" Value="{Binding Fraction, Mode=OneWay}" Height="14" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ventilation">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ChartVentilationBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ground">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ChartGroundBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource ChartTransmissionBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.legend.transmission}" Margin="0,0,14,0" />
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource ChartGroundBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.legend.ground}" Margin="0,0,14,0" />
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource ChartVentilationBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.legend.ventilation}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Parameters and envelope check -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr results.parameters}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{l:Tr results.transmissionCoefficient}" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding TransmissionCoefficient, StringFormat=N1, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.WK}" /></TextBlock>
                                    <TextBlock Grid.Row="1" Text="{l:Tr results.ventilationCoefficient}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding VentilationCoefficient, StringFormat=N1, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.WK}" /></TextBlock>
                                    <TextBlock Grid.Row="2" Text="{l:Tr results.airFlow}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding EffectiveAirFlow, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.m3h}" /></TextBlock>
                                    <TextBlock Grid.Row="3" Text="{l:Tr results.degreeDays}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding DegreeDays, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.Kd}" /></TextBlock>
                                    <TextBlock Grid.Row="4" Text="{l:Tr results.seasonLosses}" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding HeatLosses, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kWh}" /></TextBlock>
                                    <TextBlock Grid.Row="5" Text="{l:Tr results.utilisedGains}" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding UtilisedGains, StringFormat=N0, Mode=OneWay}" /><Run Text=" " /><Run Text="{l:Tr unit.kWh}" /></TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr results.envelopeCheck}" />
                                <ItemsControl ItemsSource="{Binding EnvelopeChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <Border x:Name="Pill" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="{StaticResource SuccessLightBrush}">
                                                    <TextBlock x:Name="PillText" Text="{l:Tr check.complies}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Caption}">
                                                        <Run Text="R = " /><Run Text="{Binding ActualResistance, StringFormat={}{0:N2}, Mode=OneWay}" />
                                                        <Run Text="{l:Tr results.check.required}" /><Run Text="{Binding RequiredResistance, StringFormat={}{0:N2}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Complies}" Value="False">
                                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerLightBrush}" />
                                                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter TargetName="PillText" Property="Text" Value="{l:Tr check.fails}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Energy by outdoor temperature -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr results.binChart}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,-6,0,12"
                                   Text="{l:Tr results.binChart.note}" />
                        <ItemsControl ItemsSource="{Binding BinBars}" Height="190">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0" ToolTip="{Binding ValueText}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="{Binding Height}" CornerRadius="3,3,0,0" Background="{StaticResource AccentBrush}" Opacity="0.85" />
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr results.binChart.axis}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
