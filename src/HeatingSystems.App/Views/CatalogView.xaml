<UserControl x:Class="HeatingSystems.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,24">
        <!-- Filters -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Скинути" Command="{Binding ResetFiltersCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="White" Margin="0,0,6,0" />
                            <TextBlock Text="Шукати" />
                        </StackPanel>
                    </Button>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             ToolTip="Пошук за виробником, серією або моделлю (кілька слів — усі мають збігатися)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="Виробник" />
                        <ComboBox Width="230" ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding Manufacturer}" IsEditable="True" IsTextSearchEnabled="True" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="Джерело" />
                        <ComboBox Width="160" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding Source}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="Компресор" />
                        <ComboBox Width="150" ItemsSource="{Binding ControlOptions}" SelectedItem="{Binding Control}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="Холодоагент" />
                        <ComboBox Width="100" ItemsSource="{Binding Refrigerants}" SelectedItem="{Binding Refrigerant}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="P35 від, кВт" />
                        <TextBox Width="70" Text="{Binding MinPower, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="до, кВт" />
                        <TextBox Width="70" Text="{Binding MaxPower, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="SCOP від" />
                        <TextBox Width="60" Text="{Binding MinScop, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="Шум до, дБ(А)" />
                        <TextBox Width="70" Text="{Binding MaxNoise, Converter={StaticResource Num}, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Caption}" Text="Сортування" />
                        <ComboBox Width="190" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Statistics}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Pager -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding PreviousPageCommand}" ToolTip="Попередня сторінка">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" />
                </Button>
                <Button Command="{Binding NextPageCommand}" ToolTip="Наступна сторінка">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Виробник" Binding="{Binding Manufacturer}" Width="1.2*" />
                    <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="2*" />
                    <DataGridTextColumn Header="P35, кВт" Binding="{Binding RatedPowerLowTemp, StringFormat={}{0:N1}}" Width="70" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="P55, кВт" Binding="{Binding RatedPowerMediumTemp, StringFormat={}{0:N1}}" Width="70" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="SCOP" Binding="{Binding Scop, StringFormat={}{0:N2}}" Width="60" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="ηs35, %" Binding="{Binding EtaSLowTemp, StringFormat={}{0:N0}}" Width="65" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="Хол." Binding="{Binding Refrigerant}" Width="60" />
                    <DataGridTextColumn Header="Шум, дБ" Binding="{Binding SoundPowerOutdoor, StringFormat={}{0:N0}}" Width="65" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="tmax, °C" Binding="{Binding MaxFlowTemperature, StringFormat={}{0:N0}}" Width="65" ElementStyle="{StaticResource NumericCell}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Details -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.Manufacturer}" />
                        <TextBlock Text="{Binding Selected.Model}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.Series}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Тип" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSource}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Компресор" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedControl}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Text="SCOP сертифікований (35 °C)" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Scop, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Text="SCOP за моделлю (EN 14825)" Margin="0,2" ToolTip="Відтворення сертифікованого SCOP регресійною моделлю — перевірка точності" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModelScop, StringFormat={}{0:N2}}" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" />
                            <TextBlock Grid.Row="4" Text="ηs 35 / 55 °C, %" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold">
                                <Run Text="{Binding Selected.EtaSLowTemp, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Selected.EtaSMediumTemp, StringFormat={}{0:N0}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="5" Text="Нижня межа роботи TOL" Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.OperationLimitTemperature, StringFormat='{}{0:N0} °C', TargetNullValue='—'}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="6" Text="Холодоагент, заправка" Margin="0,2" />
                            <TextBlock Grid.Row="6" Grid.Column="1" FontWeight="SemiBold">
                                <Run Text="{Binding Selected.Refrigerant, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Selected.RefrigerantMassKg, StringFormat='{}{0:N2} кг', TargetNullValue='н/д', Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="7" Text="Дата сертифікації" Margin="0,2" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Selected.CertificationDate, TargetNullValue='н/д'}" FontWeight="SemiBold" />
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Робочі точки (модель hplib)" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding CopPoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Condition}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Cop, StringFormat='COP {0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding MaxOutputKw, StringFormat='{}{0:N1} кВт'}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="A — температура повітря, B — розсолу, W — води на виході, °C. Потужність — максимальна при цих умовах." />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
