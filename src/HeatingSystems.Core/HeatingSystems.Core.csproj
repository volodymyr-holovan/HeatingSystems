<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>HeatingSystems.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\strings-en.json" LogicalName="HeatingSystems.Core.Localization.strings-en.json" />
    <EmbeddedResource Include="Localization\strings-uk.json" LogicalName="HeatingSystems.Core.Localization.strings-uk.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HeatingSystems.Tests" />
  </ItemGroup>
</Project>
