<Window x:Class="HeatingSystems.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Системи опалення" Height="600" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <!-- Температура -->
            <GroupBox Header="Температура" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Максимальна бажана температура:" Width="200"/>
                        <TextBox x:Name="MaxTemperatureTextBox" Width="100"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Мінімальна бажана температура:" Width="200"/>
                        <TextBox x:Name="MinTemperatureTextBox" Width="100"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Середньорічна температура:" Width="200"/>
                        <TextBox x:Name="AvgTemperatureTextBox" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Приміщення -->
            <GroupBox Header="Приміщення" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Стіни -->
                    <GroupBox Header="Стіни" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Label Content="Загальна площа зовнішніх стін:" Width="200"/>
                                <TextBox x:Name="WallAreaTextBox" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Label Content="Загальний об'єм приміщення:" Width="200"/>
                                <TextBox x:Name="RoomVolumeTextBox" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Label Content="Товщина стін:" Width="200"/>
                                <TextBox x:Name="WallThicknessTextBox" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Label Content="Матеріал стін:" Width="200"/>
                                <ComboBox x:Name="WallMaterialComboBox"
                                          Width="100"
                                          ItemsSource="{Binding WallMaterialEnumValues}"
                                          SelectedItem="{Binding WallMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Label Content="Матеріал утеплення:" Width="200"/>
                                <ComboBox x:Name="InsulationMaterialComboBox"
                                          Width="100"
                                          ItemsSource="{Binding InsulationMaterialEnumValues}"
                                          SelectedItem="{Binding InsulationMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Вікна -->
                    <GroupBox Header="Вікна">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Label Content="Загальна площа вікон:" Width="200"/>
                                <TextBox x:Name="WindowAreaTextBox" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Label Content="Матеріал вікон:" Width="200"/>
                                <ComboBox x:Name="WindowMaterialComboBox"
                                          Width="100"
                                          ItemsSource="{Binding WindowMaterialEnumValues}"
                                          SelectedItem="{Binding WindowMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </GroupBox>

            <!-- Кнопки -->
            <GroupBox Header="Кнопки">
                <StackPanel>
                    <CheckBox x:Name="RoofAccessCheckBox" Content="Доступ до даху" Margin="0,5"/>
                    <CheckBox x:Name="InsulationCheckBox" Content="Наявність утеплення" Margin="0,5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>
